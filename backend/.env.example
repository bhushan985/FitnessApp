# NutriRegion Backend Environment Configuration Example

# Server Port
PORT=5000

# MongoDB Connection URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nutriregion?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Allowed CORS Origins (Comma-separated origins for production, e.g. https://nutriregion.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.0.122:3000

# Geocoding & Payment Services
GEOCODING_API_KEY=your_geocoding_api_key_optional
RAZORPAY_KEY_ID=your_razorpay_key_id_optional
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_optional
